# Copy this file to .env and fill it in. Never commit .env itself.
# .env is already in .gitignore.

# Server
PORT=5000
NODE_ENV=development

# MySQL (see schema.sql for the tables the backend expects)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Leave blank if your local MySQL user has no password (e.g. XAMPP root).
DB_PASS=
DB_NAME=campuscare

# JWT — use a long random string. Without this the server refuses to start.
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin for CORS, and for password-reset links in emails.
# If CORS_ORIGIN is not set, all origins are allowed (development only).
# CORS_ORIGIN=http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# Email for password reset (required for reset emails to actually arrive).
# Without SMTP, forgot-password still returns a generic success message,
# but in development only the reset token is printed to the server log,
# and in production no email is sent at all.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=CampusCare <you@example.com>
